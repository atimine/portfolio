				</svg>
				<span>Experience &amp; Impact</span>
			</a>
			<a href='/tabs/projects' class='side-link'>
				<svg
					width='18'
					height='18'
					viewBox='0 0 24 24'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
					stroke-linejoin='round'
				>
					<path
						d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'
					/>
					<polyline points='14 2 14 8 20 8' />
				</svg>
				<span>Things I've Built</span>
			</a>
			<a href='/tabs/education' class='side-link'>
				<svg
					width='18'
					height='18'
					viewBox='0 0 24 24'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
