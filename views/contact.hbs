				</svg>
				<span>Who am I?</span>
			</a>
			<a href='/tabs/skills' class='side-link'>
				<svg
					width='18'
					height='18'
					viewBox='0 0 24 24'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
