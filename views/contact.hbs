					<path d='M22 10 12 5 2 10l10 5 10-5Z' />
					<path d='M6 12v5c0 1.5 3 3 6 3s6-1.5 6-3v-5' />
				</svg>
				<span>Academic Path</span>
			</a>
			<a href='/tabs/contact' class='side-link is-active'>
				<svg
					width='18'
					height='18'
					viewBox='0 0 24 24'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
					stroke-linejoin='round'
				>
					<path
						d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'
					/>
				</svg>
				<span>Let's Talk</span>
			</a>
		</nav>

		<!-- ===== CONTENT CARD ===== -->
		<section class='panel'>
			<div class='panel-head'>
				<div class='contact-icon-box'>
					<svg width='28' height='28' viewBox='0 0 24 24' fill='none'><path
							d='M3 6h18v12H3z'
							stroke='#2563eb'
							stroke-width='1.6'
						/><path
							d='m3 6 9 7 9-7'
							stroke='#2563eb'
							stroke-width='1.6'
							stroke-linecap='round'
							stroke-linejoin='round'
						/></svg>
				</div>
				<h2 class='panel-title'>Contact Me</h2>
			</div>

			<p class='panel-intro'>
				Great work starts with great conversations. Whether you want to
				brainstorm ideas, collaborate on something exciting, or just say hi! I'm
				always open to meaningful chats. Let's connect and build something worth
				talking about.
			</p>

			<div class='contact-body'>
				<div class='contact-rail' aria-hidden='true'>
					<span class='contact-rail-text'>Let&rsquo;s Connect &#10022;
						Let&rsquo;s Connect &#10022; Let&rsquo;s Connect &#10022;</span>
				</div>

				<form class='contact-form'>
					<div class='form-row'>
						<div class='form-field'>
							<label for='first-name'>First name
								<span class='required'>*</span></label>
							<input
								type='text'
								id='first-name'
								name='firstName'
								placeholder='Your First Name'
								value='{{result.firstname}}'
								required
							/>
						</div>
						<div class='form-field'>
							<label for='last-name'>Last name</label>
							<input
								type='text'
								id='last-name'
								name='lastName'
								placeholder='Your Last Name'
								value='{{result.lastname}}'
							/>
						</div>
					</div>

					<div class='form-field'>
						<label for='email'>Email <span class='required'>*</span></label>
						<input
							type='email'
							id='email'
							name='email'
							placeholder='your@email.com'
							value='{{result.email}}'
							required
						/>
					</div>

					<div class='form-field'>
						<label for='message'>Message
							<span class='required'>*</span></label>
						<textarea
							id='message'
							name='message'
							rows='5'
							placeholder='Write your message&hellip;'
							required
						>{{result.message}}</textarea>
					</div>

					<div class='form-submit'>
						<button type='submit' class='btn-glow'>
							Let's Talk
							<svg
								width='16'
								height='16'
								viewBox='0 0 24 24'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
							><line x1='22' y1='2' x2='11' y2='13' /><polygon
									points='22 2 15 22 11 13 2 9 22 2'
								/></svg>
						</button>
					</div>
				</form>
			</div>
		</section>

	</div>
</main>

