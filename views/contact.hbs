<section class='hero'>

	<header class='site-header'>
		<div class='wrap header-inner'>
			<a href='/' class='logo'>Adham</a>
			<button class='icon-btn' id='view-toggle' aria-label='Toggle view'>
				<svg
					width='18'
					height='18'
					viewBox='0 0 24 24'
					fill='none'
					stroke='currentColor'
					stroke-width='2'
					stroke-linecap='round'
					stroke-linejoin='round'
				>
					<rect x='2' y='3' width='20' height='14' rx='2' />
					<line x1='8' y1='21' x2='16' y2='21' />
					<line x1='12' y1='17' x2='12' y2='21' />
				</svg>
			</button>
		</div>
	</header>

	<div class='wrap'>
		<p class='eyebrow'>Hi, I'm</p>
		<h1 class='hero-name'>Adham Khudayberganov</h1>
		<p class='hero-line'>
			The backstage engineer of the web. Building with
			<span class='hero-rotate' id='hero-rotate'>Node.js</span>
		</p>
	</div>

</section>

